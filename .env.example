# Database (Neon PostgreSQL or any PostgreSQL)
# Use the pooler URL for DATABASE_URL (better for serverless). Add connect_timeout for faster failure when DB is unreachable.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/database?sslmode=require&connect_timeout=10"
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/database?sslmode=require"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# OAuth Providers (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="MichiganDance.Life <noreply@michigandance.life>"

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Canonical site URL for SEO (sitemap, Open Graph, JSON-LD). Use production URL in Vercel.
NEXT_PUBLIC_SITE_URL="https://michigandance.life"
# Optional: Google Search Console HTML tag verification
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
# Analytics: Vercel Web Analytics is wired in layout (enable in Vercel dashboard).
# Optional third-party — set one:
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Cron Jobs
CRON_SECRET="your-cron-secret-here"
